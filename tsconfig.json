{
	"extends": "./node_modules/$app/tsconfig.json",
	"include": [
		".svelte-kit/ambient.d.ts",
		".svelte-kit/non-ambient.d.ts",
		".svelte-kit/types/**/$types.d.ts",
		"vite.config.js",
		"vite.config.ts",
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte"
	],
	"exclude": ["src/server.ts"],
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"types": ["$app/types", "bun-types"]
	}
}
